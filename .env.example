# Server Environment Variables
PORT=5003
NODE_ENV=development

# API Base URL
VITE_API_BASE_URL=https://192.163.0.23:5003
API_BASE_URL=https://192.163.0.23:5003

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Dotenv Configuration
DOTENV_CONFIG_QUIET=true

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/eco_development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# SSL / HTTPS Configuration
USE_HTTPS=true
SSL_KEY_PATH=./backend/certs/key.pem
SSL_CERT_PATH=./backend/certs/cert.pem
