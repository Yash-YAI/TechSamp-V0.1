# Server Environment Variables
PORT=5003
NODE_ENV=development

# API Base URL
VITE_API_BASE_URL=https://localhost:5003
API_BASE_URL=https://localhost:5003

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Dotenv Configuration
DOTENV_CONFIG_QUIET=true

# Database Configuration (MongoDB Multi-Database Connections)
# 1. Main User Database
MONGO_URI=mongodb://localhost:27017/your_user_db
MongoDB_URI_ym_eco_board=mongodb://localhost:27017/your_user_db

# 2. Tech & Samp Database
MongoDB_URI_ym_ypm=mongodb://localhost:27017/your_techsamp_db
MONGO_URI_TECHSAMP=mongodb://localhost:27017/your_techsamp_db

# 3. Production Operations Database
MongoDB_URI_ym_prod=mongodb://localhost:27017/your_prod_db
MONGO_URI_PROD=mongodb://localhost:27017/your_prod_db

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# SSL / HTTPS Configuration
USE_HTTPS=true
SSL_KEY_PATH=./backend/certs/key.pem
SSL_CERT_PATH=./backend/certs/cert.pem
